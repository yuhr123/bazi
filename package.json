{
  "name": "bazi",
  "version": "0.1.0",
  "type": "module",
  "module": "./src/smithery.ts",
  "description": "精准的八字排盘工具，提供 Web 界面和 API 服务",
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.45.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuhr123/bazi.git"
  },
  "keywords": [
    "bazi",
    "八字",
    "命盘",
    "排盘",
    "命理",
    "chinese-astrology",
    "four-pillars"
  ],
  "license": "ISC",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "tsc": "rm -rf dist && npx tsc",
    "prepublishOnly": "npm run tsc && chmod +x dist/stdio.js",
    "smithery-dev": "npx @smithery/cli dev",
    "web": "npm run tsc && node dist/webServer.js",
    "dev:web": "tsx src/webServer.ts",
    "start": "npm run web",
    "mcp:http": "npm run tsc && node dist/httpServer.js",
    "mcp:stdio": "./dist/stdio.js",
    "build:worker": "npm run tsc",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "cf:deploy": "npm run build:worker && wrangler deploy",
    "cf:dev": "wrangler dev src/worker.ts"
  },
  "bin": {
    "bazi": "./dist/stdio.js",
    "bazi-mcp": "./dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "cantian-tymext": "^0.0.21",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.1.0",
    "tsx": "^4.20.5",
    "tyme4ts": "^1.3.4",
    "zod": "^3.24.3"
  }
}
